{
  "name": "bridge-monorepo",
  "private": true,
  "type": "module",
  "description": "bridge: work orchestration for agents + humans — web app first",
  "workspaces": [
    "packages/specs",
    "packages/ui-kit",
    "packages/worker",
    "packages/webapp",
    "packages/desktop",
    "packages/desktop/ui",
    "packages/mobile/ui"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:main-green-gate": "bash scripts/tests/main-green-gate.test.sh",
    "test:deploy-drift-alarm": "bash scripts/tests/deploy-drift-alarm.test.sh",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.6.0"
  }
}
