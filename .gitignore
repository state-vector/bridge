# secrets & local state — never commit
.env
*.token
cursor.json
node_modules/
.wrangler/
__pycache__/
*.pyc
dist/
# webapp dist IS committed: CF workers builds deploys the repo as-is (no build step configured)
!packages/webapp/dist
packages/desktop/src-tauri/target/

# local worker dev secrets
.dev.vars
# tauri generated capability schemas
packages/desktop/src-tauri/gen/
.DS_Store
packages/cli/target/
packages/mobile/ui/node_modules/
# runner scratch (when workdir points at a checkout — BR#2460)
repos/
sessions/

# webapp build artifact — built at deploy time ([build] hook in worker/wrangler.toml)
packages/webapp/dist/
packages/worker/src/__version.json

# worker test-suite dry-run output (wrangler --outdir) — build exhaust, never tracked
.kb-bundle/

# per-session throwaway worktrees (embedded repos — never part of the source tree)
.worktrees/
