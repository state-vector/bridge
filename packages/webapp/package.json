{
  "name": "@flows/webapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "bridge webapp — decisions + presence panel; served by the worker (assets) and embedded in @flows/desktop",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
