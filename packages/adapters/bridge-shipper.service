[Unit]
Description=bridge kanban shipper -> CF Worker /ingest
After=network.target

[Service]
ExecStart=/usr/bin/python3 %h/bridge/packages/adapters/kanban-shipper.py
Environment=BRIDGE_INGEST_URL=https://REPLACE-SUBDOMAIN.workers.dev/ingest
EnvironmentFile=%h/.hermes/.env
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
