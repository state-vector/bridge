{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bridge",
  "version": "0.1.0",
  "identifier": "com.statevector.bridge",
  "build": {
    "beforeDevCommand": "npm run dev -w @bridge/gateway-ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build -w @bridge/gateway-ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bridge",
        "width": 1024,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "visible": true,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "resizable": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
