{
  "name": "@flows/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "bridge desktop — gateway/dispatch shell (minimal gateway UI + Rust dispatch core)",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:headless": "cargo build --manifest-path src-tauri/Cargo.toml && ./src-tauri/target/debug/bridge-desktop --headless",
    "start:headless": "cargo build --release --manifest-path src-tauri/Cargo.toml && ./src-tauri/target/release/bridge-desktop --headless"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
